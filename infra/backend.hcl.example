# state（Terraform の記録）を置く S3 の設定の見本
# このファイルを backend.hcl という名前でコピーし、本当の値に書き換える。
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
# backend.hcl は .gitignore に入っているので、GitHub には上がらない。
# バケットは前もって作っておく必要がある（Terraform では作らない）。

bucket       = "taskmanagement-tfstate-123456789012"
key          = "infra/terraform.tfstate"
region       = "ap-northeast-1"
profile      = "taskmanagement"
encrypt      = true
use_lockfile = true
