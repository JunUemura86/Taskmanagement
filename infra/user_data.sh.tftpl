#!/bin/bash
# EC2 が初めて起動したときに1回だけ実行されるスクリプト（user_data）
# 実行の記録は EC2 の中の /var/log/user-data.log に残る。
# 注意：このファイルは Terraform のテンプレートなので、$ と { を続けて書くと Terraform の変数として扱われる。
#       シェルの変数は $NAME の形（波かっこなし）で書く。
set -euxo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

# 1. スワップ 2GB を作る（メモリ 1GB の t4g.micro で、ビルド中にメモリが足りなくなるのを防ぐ）
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

# 2. Docker と Git を入れる（Java は入れない。Java はコンテナの中で動かす）
dnf install -y docker git
systemctl enable --now docker

# 3. Docker Compose と Buildx（docker compose build に必要）を入れる。arm64 版
PLUGIN_DIR=/usr/local/lib/docker/cli-plugins
mkdir -p $PLUGIN_DIR
curl -fsSL -o $PLUGIN_DIR/docker-compose \
  https://github.com/docker/compose/releases/latest/download/docker-compose-linux-aarch64
BUILDX_VERSION=$(curl -fsSL https://api.github.com/repos/docker/buildx/releases/latest | grep -m1 '"tag_name"' | cut -d '"' -f 4)
curl -fsSL -o $PLUGIN_DIR/docker-buildx \
  https://github.com/docker/buildx/releases/download/$BUILDX_VERSION/buildx-$BUILDX_VERSION.linux-arm64
chmod +x $PLUGIN_DIR/docker-compose $PLUGIN_DIR/docker-buildx
docker compose version
docker buildx version

# 4. アプリのリポジトリを clone する（公開リポジトリなので鍵はいらない）
APP_DIR=/opt/taskmanagement
if [ ! -d $APP_DIR/.git ]; then
  git clone --depth 1 --branch "${repo_branch}" "${repo_url}" $APP_DIR
fi
cd $APP_DIR

# 5. 本番用の Compose ファイルがあれば、ビルドして起動する
#    （本番用のファイルはロードマップの段階1で作る。まだなければ、何もせずに終わる）
if [ -f "${compose_file}" ]; then
  docker compose -f "${compose_file}" build
  docker compose -f "${compose_file}" up -d
else
  echo "${compose_file} がまだありません。ロードマップの段階1で作ってから、EC2 を作り直してください。"
fi
