{
  "permissions": {
    "allow": [
      "Bash(docker --version)",
      "Bash(docker info *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker compose version)",
      "Bash(docker compose up -d)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_ENV_FILE\" ] && echo 'export PATH=\"$HOME/.docker/bin:$HOME/.local/bin:$PATH\"' >> \"$CLAUDE_ENV_FILE\" || true",
            "statusMessage": "docker と gh を使えるように PATH を設定中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.py\"",
            "statusMessage": "Git 運用ルールをチェック中..."
          },
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-ports.py\"",
            "statusMessage": "サーバーのポートをチェック中..."
          }
        ]
      }
    ]
  }
}
